{
  "name": "البصمة الذكية - نظام سندات الاستلام الرسمية",
  "short_name": "سندات البصمة",
  "description": "نظام إدارة وطباعة وتصدير سندات القبض والدفع المالية الاحترافية متوافق مع كافة الأجهزة",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0f172a",
  "theme_color": "#4f46e5",
  "orientation": "any",
  "lang": "ar",
  "dir": "rtl",
  "prefer_related_applications": false,
  "categories": ["finance", "business", "productivity", "utilities"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "إنشاء سند جديد",
      "short_name": "سند جديد",
      "description": "تحرير وإنشاء سند قبض مالي جديد",
      "url": "/?action=new",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "سجل السندات",
      "short_name": "السجلات",
      "description": "استعراض كافة السندات المخزنة وتصديرها",
      "url": "/?tab=history",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "إعدادات المنشأة",
      "short_name": "الإعدادات",
      "description": "تخصيص الشعار والعملة والتوقيعات والأختام",
      "url": "/?tab=settings",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    }
  ],
