# Deshal ERP Environment Variable Template
# Copy this file to .env and fill in environment-specific values.
# NEVER commit real .env files with production secrets to version control.

# Application Server Port & Environment
PORT=3000
NODE_ENV=production

# Application Metadata & Base URLs
VITE_APP_TITLE=Deshal ERP
VITE_APP_URL=http://localhost:3000

# AI Services Integration (Server-side key)
# GEMINI_API_KEY=your_production_gemini_api_key_here

# Supabase Persistence Integration (Optional)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
