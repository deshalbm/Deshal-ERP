# Deshal ERP Environment Variable Template
# Copy this file to .env and fill in environment-specific values.
# NEVER commit real .env files with production secrets to version control.

# Application Server Port & Environment
PORT=3000
NODE_ENV=production

# Application Metadata & Base URLs
VITE_APP_TITLE=Deshal ERP
VITE_APP_URL=https://erp.deshalbm.com
APP_URL=https://erp.deshalbm.com

# Supabase Persistence Integration
VITE_SUPABASE_URL=https://iewceykescyycodllftl.supabase.co
VITE_SUPABASE_ANON_KEY=

# Resend Transactional Email Gateway (SERVER-SIDE SECRET ONLY - NEVER EXPOSE IN VITE_ OR FRONTEND)
RESEND_API_KEY=
EMAIL_FROM=Deshal ERP <app@portal.deshalbm.com>
EMAIL_ENABLED=true
